{
  "openapi": "3.1.1",
  "info": {
    "title": "Fault Code API",
    "description": "Public synthetic foundation operations. Future protected operations use dedicated Entra OAuth2 authorization code + PKCE with delegated scopes, or client credentials with app roles. Tenant, audience, scope and role values will be configured in FAU-8/9; no placeholder OAuth URLs are executable.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/examples": {
      "get": {
        "tags": [
          "Examples"
        ],
        "operationId": "ListExamples",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "system",
            "in": "query",
            "schema": {
              "pattern": "^(EPS|steer-by-wire|steering-ADAS)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "headers": {
              "X-Correlation-ID": {
                "description": "Server-generated request correlation ID, also returned in Problem Details.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Request failed",
                  "status": 400,
                  "instance": "/api/v1/examples",
                  "correlationId": "5ce0d2ac05434c56980a058cfd2e8fa7"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Correlation-ID": {
                "description": "Server-generated request correlation ID, also returned in Problem Details.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Request failed",
                  "status": 500,
                  "instance": "/api/v1/examples",
                  "correlationId": "5ce0d2ac05434c56980a058cfd2e8fa7"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "X-Correlation-ID": {
                "description": "Server-generated request correlation ID, also returned in Problem Details.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfExampleResponse"
                },
                "example": {
                  "items": [
                    {
                      "id": "synthetic-001",
                      "system": "EPS",
                      "description": "Synthetic electric power steering example"
                    }
                  ],
                  "page": 1,
                  "pageSize": 1,
                  "totalCount": 3
                }
              }
            }
          }
        },
        "security": [ ]
